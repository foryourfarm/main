# 복사해서 .env 로 쓰기 (실제 .env 는 커밋 금지 — .gitignore 대상)
DATABASE_URL=postgresql+psycopg://foryourfarm:foryourfarm@localhost:5432/foryourfarm

# 로컬 LLM (개발: Ollama / 서빙: vLLM, 둘 다 OpenAI 호환)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=exaone3.5:7.8b
LLM_TIMEOUT_S=8

# 공공데이터 API 키 (발급 전까지 비움)
WEATHER_API_KEY=
SOIL_API_KEY=
