# 복사해서 .env 로 쓰기 (실제 .env 는 커밋 금지 — .gitignore 대상)
#
# 놓을 위치: **리포 루트 `.env` 한 곳만** 읽는다(`backend/.env`는 안 읽는다).
#   두 군데를 읽던 시절 키를 한쪽에만 넣어 조용히 빈 값이 되는 사고가 있었다.
#   → app/core/config.py의 env_file 참고.
# 키 이름: config.py의 Settings 필드명과 그대로 대응한다. 대소문자는 구분하지 않으므로
#   WEATHER_API / weather_API / weather_api 다 같이 읽힌다. `KEY = value`처럼 = 앞뒤에
#   공백이 있어도 무시된다.
# **필드를 추가하거나 이름을 바꾸면 이 파일도 같이 고친다** — 여기가 "필요한 키 목록"
#   문서다. config.py에 없는 이름으로 넣으면 조용히 무시되고(extra="ignore") 빈 값이 된다.

DATABASE_URL=postgresql+psycopg://foryourfarm:foryourfarm@localhost:5432/foryourfarm

# 로컬 LLM (개발: Ollama / 서빙: vLLM, 둘 다 OpenAI 호환)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=exaone3.5:7.8b
# 생성 런타임: ollama | vllm. vLLM 전환은 이 값 + LLM_BASE_URL(:8000)만 바꾸면 되고
# 재배포가 필요 없다(--update-env-vars). 되돌리기도 같은 방법. 상세: docs/vllm.md
# LLM_BACKEND=ollama
# Qwen3 계열 "생각 모드" 차단. **끄면(false) Qwen3가 답변을 아예 안 준다** — L4 vLLM 실측상
# max_tokens를 전부 영어 내부 사고에 쓰고 finish_reason=length로 끝난다. EXAONE엔 무해(무시됨).
# LLM_DISABLE_THINKING=true
# 임베딩 서버 주소. **비워 두면 LLM_BASE_URL을 쓴다**(지금까지의 동작).
# vLLM 전환 시 생성만 :8000으로 옮기고 임베딩은 Ollama(:11434)에 남긴다 — bge-m3를 바꾸면
# knowledge_chunk 936개를 재임베딩해야 하기 때문이다(docs/vllm.md §4).
# EMBEDDING_BASE_URL=http://localhost:11434
LLM_TIMEOUT_S=90

# 챗봇 RAG — 검색 임베딩 모델(bge-m3, 1024차원). `ollama pull bge-m3` 필요.
EMBEDDING_MODEL=bge-m3
# 아래는 config.py 기본값과 동일 — 조정할 때만 주석 해제(선택).
# LLM_NUM_PREDICT=768           # 생성 길이 캡(200 -> 512 -> 768, 목록형 답변 절단 대응)
# LLM_TEMPERATURE=0.4           # 낮게(사실 일관성 우선)
# 입력 컨텍스트 창. **명시 안 하면 Ollama가 4096으로 로드한다**(모델은 32k 지원).
# RAG 최악 케이스 프롬프트가 실측 3,691토큰이라 4096으로는 여유가 405토큰뿐이고,
# 넘으면 프롬프트 앞쪽(#보안 규칙)이 잘린다 — 출력 절단보다 나쁘다.
# LLM_NUM_CTX=8192
# RAG_TOP_K=3                   # 질문당 근거 조각 수
# CHAT_HISTORY_MAX_MESSAGES=6   # 멀티턴 프롬프트에 넣을 최근 메시지 수

# ── 공공데이터 API 인증키 ──────────────────────────────────────────────────
# API별로 분리한다: data.go.kr은 승인 세트마다 키가 달라 하나로 뭉치면 승인 안 된 API를
# 잘못된 키로 호출한다. 발급 전까지 비워 둔다(빈 값이면 그 API만 실패, 앱은 뜬다).

# 농경지화학성 통계정보 V2
CHEMICAL_STATUS_API=
# 토양검정 화학성 상세정보 V2
CHEMISTRY_API=
# 토양도 기반 토양특성 단면정보 V2 (15098809) — 심토토성·자갈·경사 3종
SOIL_API=
# 토양도 기반 토양특성 상세정보 V3 (15144225) — 27종(과수적성등급·제약인자 등). 화학성 없음.
# SOIL_API와 **다른 데이터셋이라 키도 다르다** — 서로 바꿔 넣으면 인증 실패한다.
SOIL_DETAIL_API=
# 농업기상 기본 관측데이터(과거 실측)
WEATHER_API=
# 농업기상 관측지점 정보(지점 위경도)
WEATHER_OBSERVATORY_API=
# 기상청 단기예보 조회서비스(단기 탭)
WEATHER_FORECAST_API=
# VWorld — 주소 → PNU 변환. 필드명이 `vworld_apikey`라 `VWORLD_API`로는 안 읽힌다(`key` 접미사 필수).
VWORLD_APIkey=
# 작물별 비료 표준사용량 처방 정보 (15075889) — 작물코드만 입력, 토양 결측 밭에도 쓸 수 있다.
FERTILIZER_API=
# 비료사용처방 **체험** 정보 V2 — 위 FERTILIZER_API와 다른 데이터셋이다. 화학성 값을
# 입력으로 받으므로 토양 결측 밭엔 못 쓰고 화학성 있는 밭 전용이다.
FERTILIZER_TRIAL_API=
# 작물코드 목록 정보 — 위 두 비료 API에 넣을 작물코드를 우리 crop 5종에 매핑하는 선행 조건.
CROP_CODE_API=
# 농업기상 예비 키 — 쿼터가 엔드포인트별이라 소진 시 자동 전환한다(선택).
# WEATHER_API2=
# 3개월전망(장기 탭)은 RSS라 인증키가 없다(app/infra/public_api/outlook_client.py).

# ── 기상청 API Hub (apihub.kma.go.kr) — 위 data.go.kr 키와 **별개 발급** ──
# data.go.kr 키를 넣으면 401이다. `기상청_API-Guide.md`·`Sunlight-Calculation_API-Guide.md`가
# 문서화한 엔드포인트 전부가 이 호스트다:
#   - AWS 관측자료(typ02) — 관측지점 배선의 선행 조건
#   - 평년값 sfc_norm1.php(typ01) — 평년치 140개 지역 공백의 근본 해결
# 즉 이 키 하나가 두 작업을 동시에 막고 있다(nexttodo.md 최상단 참고).
# `WEATHER_DATA_APIkey`라는 이름으로 넣어도 읽힌다(config.py의 AliasChoices) — 과거에 그
# 이름으로 넣은 키가 있어서 호환을 남겨뒀다. 새로 넣을 때는 아래 정본 이름을 쓴다.
WEATHER_APIHUB_KEY=

# 토양변화 shadow 추론 artifact 경로. 비어 있으면 미로드 → 모든 예측이 Δ=0 폴백.
SOIL_DELTA_ARTIFACT_PATH=

# 인증 — 운영에서는 반드시 32바이트 이상 랜덤값으로 덮어쓴다(§17).
JWT_SECRET=dev-only-insecure-secret-change-in-prod-min-32-bytes

# 쿠키 속성(refresh 토큰) — 로컬 기본값은 http://localhost라 Secure=False, SameSite=Lax로 충분하다.
# **FE·BE가 서로 다른 등록 도메인(eTLD+1)에 배포되는 크로스사이트 구성이면 반드시 아래로 덮어쓴다.**
# SameSite=Lax는 fetch/XHR(서브리퀘스트)에 쿠키를 첨부하지 않는다 — top-level GET 네비게이션에만 실린다.
# 그래서 크로스사이트 배포에서 Lax를 두면 /auth/refresh가 쿠키를 못 받아 항상 401이 난다
# (로그인 직후 메모리 access token이 살아있는 동안만 정상 동작하다가 새로고침하면 복구 불능 —
# 실제 발생: FE duckdns.org ↔ BE run.app, 2026-07-26 발견, docs/auth-security.md 참고).
# SameSite=None은 Secure 없이는 브라우저가 거부하므로 반드시 같이 켠다.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# 운영 작업 엔드포인트(POST /api/v1/admin/weather-outlooks — 3개월전망 자동 갱신) 공유 시크릿.
# Cloud Scheduler가 X-Admin-Token 헤더로 보낸다. **비우면 그 엔드포인트는 503으로 꺼진다**
# (설정 누락이 곧 공개 적재 경로가 되지 않도록). 로컬 개발에는 필요 없다 — 스케줄러를 붙이는
# 배포에서만 넣는다. 값은 `openssl rand -hex 32` 같은 랜덤값으로. docs/outlook-scheduler.md
ADMIN_TASK_TOKEN=

# CORS 허용 오리진 — list[str] 필드라 pydantic-settings가 JSON 배열 문법으로만 파싱한다
# (콤마로 이어붙인 맨 문자열은 파싱 실패로 앱이 못 뜬다 — 직접 확인함). 포트/스킴 포함,
# 와일드카드 불가(allow_credentials=True 조합에서는 브라우저가 "*"를 거부한다).
# CORS_ORIGINS=["https://foryourfarm.duckdns.org"]
