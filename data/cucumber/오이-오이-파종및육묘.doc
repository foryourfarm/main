                &#49884;&#54032;&#54616;&#44592;
                &#46412;&#47928;&#50640; &#49789;&#44172;
                &#44396;&#54624; &#49688; &#51080;&#45796;.</p>
                <p>
                <br /> &#50724;&#51060;&#51333;&#51088;&#51032;
                &#48156;&#50500;&#50984;&#51008; 90%&#47196;
                &#47588;&#50864; &#51339;&#51008;&#47728;
                &#47925;&#51008; &#51333;&#51088;&#46972;&#46020;
                &#48156;&#50500;&#44032; &#51096; &#46104;&#45716;
                &#54200;&#51060;&#45796;.
                &#51217;&#47785;&#51116;&#48176;&#54624; &#46412;
                &#50724;&#51060; &#51333;&#51088;&#45716;
                300&#54217;&#45817; 2,800&sim;3,000&#47549;&#51012;
                &#54028;&#51333;&#54616;&#44256;
                &#54840;&#48149;&#51008;
                3,000&sim;3,500(&#48156;&#50500;&#50984;
                80%)&#51012; &#54028;&#51333;&#54616;&#47732;
                &#51217;&#47785;&#54876;&#52265;&#50984;&#51060;
                &#48372;&#53685; 90%&#47196; &#48380; &#46412;
                &#51201;&#51208; &#50577;&#51060;&#45796;.
                &#50728;&#46020; 25&sim;28&#8451;
                &#51312;&#44148;&#50640;&#49436;
                14&sim;15&#49884;&#44036;
                &#48156;&#50500;&#49884;&#53020;
                &#51460;&#49100;&#47548;&#51004;&#47196;
                6&times;1.5&sim;2.1cm
                &#44036;&#44201;&#51004;&#47196;
                &#54028;&#51333;&#54616;&#44256;
                &#54840;&#48149;&#51008; 8&sim;10&times;3.1cm
                &#44036;&#44201;&#51004;&#47196;
                &#54028;&#51333;&#44264;&#44284;
                &#51649;&#44033;&#51004;&#47196;
                &#54028;&#51333;&#54620; &#46244;
                &#47784;&#47000;&#47484; 1cm &#51221;&#46020;
                &#48373;&#53664;&#54620; &#54980;
                &#49888;&#47928;&#51648;&#47196; &#45934;&#50612;
                &#49845;&#46020;&#47484;
                &#50976;&#51648;&#49884;&#53416;&#45796;.
                &#44256;&#50728;&#44592;
                &#50613;&#51228;&#51089;&#54805;&#51032;
                &#50977;&#47896;&#51068;&#49688;&#45716;
                &#48376;&#50685;&#51060;
                2.5&#47588;(18&sim;22&#51068;)
                &#45236;&#50808;&#51068; &#46412;,
                &#52489;&#49457;&#51008; &#48376;&#50685;&#51060;
                3&sim;3.5&#47588;(25&sim;28&#51068;)&#44032;
                &#51201;&#45817;&#54616;&#47728;
                &#51217;&#47785;&#49884;&#45716; 3&sim;5&#51068;
                &#50672;&#51109;&#46104;&#47728; 50&#44277;
                &#54540;&#47084;&#44536;&#53944;&#47112;&#51060;&#50640;
                &#50977;&#47896;&#54616;&#47732; 3&sim;5&#51068;
                &#45800;&#52629;&#46108;&#45796;. &#46608;&#54620;
                &#48152;&#52489;&#49457;&#51116;&#48176;&#49884;&#45716;
                &#48376;&#50685;
                3&sim;3.5&#47588;(30&sim;35&#51068;)&#46412;&#44032;
                &#51201;&#45817;&#54616;&#45796;.</p>
